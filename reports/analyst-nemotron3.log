angerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"custom\\\");\"}}],[\"$\",\"$L52\",null,{\"pageMetadata\":\"$46:props:pageMetadata\"}]]\n4e:[\"$\",\"$L53\",null,{\"pageMetadata\":\"$46:props:pageMetadata\"}]\n54:T3d69,"])</script><script>self.__next_f.push([1,"/* JTL Brand Colors */\n:root {\n  --jtl-orange: #fb581f;\n  --jtl-tech-blue: #2722f8;\n  --jtl-light-blue: #89d2ff;\n  --jtl-dark-blue: #0b1b45;\n  --jtl-sand: #eeeee7;\n  --jtl-white: #ffffff;\n  --jtl-black: #000000;\n}\n\n/* Override Tailwind's bg-white to use sand in light mode,\n   so all surfaces blend with the sand page background */\n:root:not(.dark)\n  .bg-white:not(.code-block .bg-white):not(.code-block-background) {\n  background-color: var(--jtl-sand) !important;\n}\n\n/* Shift grays darker for sand background so borders/separators stay visible */\n:root:not(.dark) {\n  --gray-50: 228 223 218;\n  --gray-100: 218 213 208;\n  --gray-200: 200 195 190;\n  --gray-300: 180 175 170;\n  --gray-400: 140 135 130;\n  --gray-500: 102 97 95;\n}\n\n/* Hide default title + description on homepage (we render our own hero) */\n#header:has(~ .mdx-content .hero-gradient),\n#header:has(+ .mdx-content .hero-gradient) {\n  display: none !important;\n}\n\n/* Hero section on homepage — centered layout */\n.hero-gradient {\n  background: linear-gradient(\n    135deg,\n    rgba(251, 88, 31, 0.06) 0%,\n    rgba(137, 210, 255, 0.06) 100%\n  );\n  border-radius: 20px;\n  padding: 5rem 2.5rem 4.5rem;\n  margin-bottom: 3rem;\n}\n\n.dark .hero-gradient {\n  background: linear-gradient(\n    135deg,\n    rgba(251, 88, 31, 0.1) 0%,\n    rgba(137, 210, 255, 0.1) 100%\n  );\n}\n\n.hero-center {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n\n.hero-title {\n  font-size: 3rem;\n  line-height: 1.15;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  margin-bottom: 1rem;\n}\n\n.hero-subtitle {\n  font-size: 1.1rem;\n  line-height: 1.7;\n  max-width: 560px;\n  opacity: 0.7;\n  margin: 0 auto;\n}\n\n.hero-actions {\n  display: flex;\n  gap: 0.75rem;\n  margin-top: 2rem;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n\n.hero-cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.75rem 1.75rem;\n  border-radius: 10px;\n  font-weight: 600;\n  font-size: 0.95rem;\n  text-decoration: none;\n  transition: all 0.15s ease;\n}\n\n.hero-cta-primary {\n  background: var(--jtl-orange);\n  color: white;\n}\n\n.hero-cta-primary:hover {\n  opacity: 0.9;\n  transform: translateY(-1px);\n}\n\n.hero-cta-secondary {\n  border: 1.5px solid currentColor;\n  opacity: 0.7;\n}\n\n.hero-cta-secondary:hover {\n  opacity: 1;\n}\n\n/* Hero search input — triggers Mintlify search modal */\n.hero-search {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-top: 2rem;\n  padding: 0.75rem 1.25rem;\n  width: 100%;\n  max-width: 380px;\n  border-radius: 12px;\n  border: 1px solid rgba(0, 0, 0, 0.12);\n  background: rgba(255, 255, 255, 0.7);\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    box-shadow 0.15s ease;\n}\n\n.dark .hero-search {\n  border-color: rgba(255, 255, 255, 0.12);\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.hero-search-icon,\n.hero-search-text {\n  opacity: 0.5;\n  transition:\n    opacity 0.2s ease,\n    color 0.2s ease;\n}\n\n.hero-search:hover {\n  border-color: var(--jtl-orange);\n  box-shadow:\n    0 0 0 1px var(--jtl-orange),\n    0 2px 8px rgba(251, 88, 31, 0.15);\n}\n\n.dark .hero-search:hover {\n  border-color: var(--jtl-orange);\n  box-shadow:\n    0 0 0 1px var(--jtl-orange),\n    0 2px 8px rgba(251, 88, 31, 0.25);\n}\n\n.hero-search span {\n  font-size: 0.9rem;\n  opacity: 0.4;\n  user-select: none;\n}\n\n/* Homepage max-width container */\n.mdx-content:has(.hero-gradient),\n.mdx-content:has(.graphql-sandbox-layout) {\n  padding-top: 24px;\n  max-width: 1376px;\n  margin-left: auto;\n  margin-right: auto;\n  padding-left: 1.5rem;\n  padding-right: 1.5rem;\n}\n\n.mdx-content:has(.graphql-sandbox-layout) {\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n/* Ensure Mintlify's parent container allows the wider content on the homepage */\nmain:has(.hero-gradient),\nmain:has(.graphql-sandbox-layout),\n#content-area:has(.hero-gradient),\n#content-area:has(.graphql-sandbox-layout),\n.max-w-7xl:has(.hero-gradient) {\n  max-width: 100% !important;\n}\n\n.max-w-7xl:has(.graphql-sandbox-layout) {\n  max-width: 100% !important;\n}\n\n/* GraphQL playground: GraphiQL is a desktop-only IDE (cross-origin iframe we\n   can't restyle). On phones, keep it as a blurred preview behind a frosted\n   \"best on desktop\" overlay card. Markup lives in graphql-playground.mdx. */\n.graphql-mobile-overlay {\n  display: none;\n}\n\n@media (max-width: 768px) {\n  .graphql-desktop-only {\n    display: none !important;\n  }\n\n  .graphql-sandbox-layout iframe {\n    filter: blur(5px);\n    pointer-events: none;\n    transform: scale(1.03); /* hide the soft transparent edge the blur leaves */\n  }\n\n  .graphql-mobile-overlay {\n    display: flex;\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    align-items: center;\n    justify-content: center;\n    padding: 1.5rem;\n  }\n\n  .graphql-mobile-overlay__card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0.65rem;\n    max-width: 320px;\n    padding: 1.85rem 1.6rem;\n    text-align: center;\n    border-radius: 18px;\n    border: 1px solid rgba(255, 255, 255, 0.45);\n    background: rgba(255, 255, 255, 0.62);\n    backdrop-filter: blur(14px) saturate(160%);\n    -webkit-backdrop-filter: blur(14px) saturate(160%);\n    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.18);\n  }\n\n  .dark .graphql-mobile-overlay__card {\n    border-color: rgba(255, 255, 255, 0.12);\n    background: rgba(22, 22, 22, 0.6);\n  }\n\n  .graphql-mobile-overlay__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 48px;\n    height: 48px;\n    border-radius: 13px;\n    color: #fff;\n    background: var(--jtl-orange, #fb581f);\n    box-shadow: 0 6px 18px rgba(251, 88, 31, 0.35);\n  }\n\n  .graphql-mobile-overlay h2 {\n    font-size: 1.1rem;\n    font-weight: 700;\n    margin: 0;\n  }\n\n  .graphql-mobile-overlay p {\n    font-size: 0.9rem;\n    line-height: 1.55;\n    opacity: 0.72;\n    margin: 0;\n  }\n}\n\n/* Homepage section headers */\n.mdx-content:has(.hero-gradient) h2 {\n  margin-top: 3.5rem !important;\n  margin-bottom: 1rem !important;\n  font-size: 1.75rem !important;\n  font-weight: 700 !important;\n}\n\n.mdx-content:has(.hero-gradient) h3 {\n  margin-top: 2rem !important;\n  margin-bottom: 0.75rem !important;\n  font-size: 0.85rem !important;\n  font-weight: 600 !important;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  opacity: 0.5;\n}\n\n.mdx-content:has(.hero-gradient) hr {\n  margin-top: 3rem !important;\n  margin-bottom: 0 !important;\n  border-color: transparent;\n}\n\n/* Responsive adjustments for mobile */\n@media (max-width: 768px) {\n  .hero-gradient {\n    padding: 3rem 1.5rem 2.5rem;\n  }\n  .hero-title {\n    font-size: 2.25rem;\n  }\n  .hero-subtitle {\n    font-size: 1rem;\n    line-height: 1.5;\n  }\n  .hero-actions {\n    flex-direction: column;\n    width: 100%;\n  }\n  .hero-cta {\n    width: 100%;\n    justify-content: center;\n  }\n  .hero-search {\n    max-width: 100%;\n  }\n\n  /* Force Mintlify CardGroups to stack on mobile */\n  .mdx-content:has(.hero-gradient) .grid {\n    grid-template-columns: 1fr !important;\n  }\n}\n\n/**\n * Portal-Sidebar: nur unter #sidebar-group (ul#sidebar-group.sidebar-group).\n *\n * Trifft NUR \u003ca href=\"…\" class=\"group …\"\u003e mit .method-nav-pill — nicht die\n * Sektions-\u003cbutton class=\"group\"\u003e (Chevron), die sonst mit „group“ kollidieren könnten.\n *\n * Varianten:\n * A) [data-nav-tag] irgendwo im \u003ca\u003e → Grid: Titel | Cloud + deprecated gestapelt\n * B) ohne [data-nav-tag] → Flex: Titel | optional deprecated (euer HTML)\n *\n * Hinweise:\n * - Kein erzwungenes background:transparent — aktuelle Route darf bg-primary/10 o. ä. behalten.\n * - Optional: data-badge-layout=\"cloud-only\" | \"depr-only\" (nur Variante A)\n */\n\n/* ========== Basis: Endpoint-Links (nur \u003ca\u003e, nur in #sidebar-group) ========== */\n#sidebar-group a[href].group:has(.method-nav-pill) {\n  display: grid !important;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center !important;\n  font-size: 13px;\n  /* Portal setzt oft padding-left per inline-Style (z. B. 1.75rem) → nur !important überschreibt */\n  padding-inline-start: 1rem !important;\n  column-gap: 0.5rem !important;\n  transition-property: background-color;\n  transition-duration: 0.12s;\n  transition-timing-function: ease-out;\n  -webkit-tap-highlight-color: transparent;\n}\n\n#sidebar-group a[href].group:has(.method-nav-pill) \u003e div:nth-child(1) {\n  grid-column: 2;\n  grid-row: 1;\n  align-self: center;\n  justify-self: end;\n  margin: 0 !important;\n}\n\n#sidebar-group a[href].group:has(.method-nav-pill) \u003e div:nth-child(2) {\n  grid-column: 1;\n  grid-row: 1;\n  min-width: 0;\n}\n\n/* Method-Spalte: feste Breite → alle Titel beginnen auf einer Linie (PATCH) */\n#sidebar-group a[href].group:has(.method-nav-pill) .method-nav-pill {\n  display: flex !important;\n  flex: 0 0 2.625rem !important;\n  min-width: 2.625rem !important;\n  width: 2.625rem !important;\n  max-width: 2.625rem !important;\n  justify-content: flex-end !important;\n}\n\n/* ========== B: ohne Cloud ========== */\n#sidebar-group\n  a[href].group:has(.method-nav-pill):not(:has([data-nav-tag]))\n  \u003e div:nth-child(2) {\n  display: flex !important;\n  align-items: center !important;\n  flex-wrap: nowrap;\n  min-width: 0;\n  column-gap: 0.5rem;\n}\n\n#sidebar-group\n  a[href].group:has(.method-nav-pill):not(:has([data-nav-tag]))\n  \u003e div:nth-child(2)\n  \u003e * {\n  margin-