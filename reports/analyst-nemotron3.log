:root {
  --jtl-orange: #fb581f;
  --jtl-tech-blue: #2722f8;
  --jtl-light-blue: #89d2ff;
  --jtl-dark-blue: #0b1b45;
  --jtl-sand: #eeeee7;
  --jtl-white: #ffffff;
  --jtl-black: #000000;
}

/* Override Tailwind's bg-white to use sand in light mode,
   so all surfaces blend with the sand page background */
:root:not(.dark)
  .bg-white:not(.code-block .bg-white):not(.code-block-background) {
  background-color: var(--jtl-sand) !important;
}

/* Shift grays darker for sand background so borders/separators stay visible */
:root:not(.dark) {
  --gray-50: 228 223 218;
  --gray-100: 218 213 208;
  --gray-200: 200 195 190;
  --gray-300: 180 175 170;
  --gray-400: 140 135 130;
  --gray-500: 102 97 95;
}

/* Hide default title + description on homepage (we render our own hero) */
#header:has(~ .mdx-content .hero-gradient),
#header:has(+ .mdx-content .hero-gradient) {
  display: none !important;
}

/* Hero section on homepage — centered layout */
.hero-gradient {
  background: linear-gradient(
    135deg,
    rgba(251, 88, 31, 0.06) 0%,
    rgba(137, 210, 255, 0.06) 100%
  );
  border-radius: 20px;
  padding: 5rem 2.5rem 4.5rem;
  margin-bottom: 3rem;
}

.dark .hero-gradient {
  background: linear-gradient(
    135deg,
    rgba(251, 88, 31, 0.1) 0%,
    rgba(137, 210, 255, 0.1) 100%
  );
}

.hero-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-title {
  font-size: 3rem;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
}

.hero-subtitle {
  font-size: 1.1rem;
  line-height: 1.7;
  max-width: 560px;
  opacity: 0.7;
  margin: 0 auto;
}

.hero-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2rem;
  flex-wrap: wrap;
  justify-content: center;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.75rem;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  transition: all 0.15s ease;
}

.hero-cta-primary {
  background: var(--jtl-orange);
  color: white;
}

.hero-cta-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.hero-cta-secondary {
  border: 1.5px solid currentColor;
  opacity: 0.7;
}

.hero-cta-secondary:hover {
  opacity: 1;
}

/* Hero search input — triggers Mintlify search modal */
.hero-search {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 2rem;
  padding: 0.75rem 1.25rem;
  width: 100%;
  max-width: 380px;
  border-radius: 12px;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.dark .hero-search {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.05);
}

.hero-search-icon,
.hero-search-text {
  opacity: 0.5;
  transition:
    opacity 0.2s ease,
    color 0.2s ease;
}

.hero-search:hover {
  border-color: var(--jtl-orange);
  box-shadow:
    0 0 0 1px var(--jtl-orange),
    0 2px 8px rgba(251, 88, 31, 0.15);
}

.dark .hero-search:hover {
  border-color: var(--jtl-orange);
  box-shadow:
    0 0 0 1px var(--jtl-orange),
    0 2px 8px rgba(251, 88, 31, 0.25);
}

.hero-search span {
  font-size: 0.9rem;
  opacity: 0.4;
  user-select: none;
}

/* Homepage max-width container */
.mdx-content:has(.hero-gradient),
.mdx-content:has(.graphql-sandbox-layout) {
