ives in the blank home tab, but Mintlify falls back to\n   marking the next tab (\"Get Started\") active on this route. Scope to the home\n   page only and neutralize the highlight so no tab looks selected: drop the\n   faux-bold text-shadow and hide the bottom underline bar (the child div). */\nhtml[data-current-path=\"/\"] .nav-tabs-item[data-active] {\n  text-shadow: none !important;\n  color: light-dark(rgb(var(--gray-600)), rgb(var(--gray-400))) !important;\n}\n\nhtml[data-current-path=\"/\"] .nav-tabs-item[data-active] \u003e div {\n  display: none !important;\n}\n\n/* On hover, bring the underline back but in grey, so the tab still has a\n   hover affordance without looking selected. */\nhtml[data-current-path=\"/\"] .nav-tabs-item[data-active]:hover \u003e div {\n  display: block !important;\n  background: light-dark(rgb(var(--gray-300)), rgb(var(--gray-500))) !important;\n}\n"])</script><script>self.__next_f.push([1,"4f:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$54\"}}],\"$L55\"]\n57:T624,"])</script><script>self.__next_f.push([1,"// Injects section headers into the API Reference dropdown menu.\n// Mintlify auto-loads any .js file at the content root on every page.\n(function () {\n  const SECTIONS = [\n    { before: \"ERP (JTL-Wawi)\", label: \"ERP\" },\n    { before: \"SCX Channel API\", label: \"SCX\" },\n  ];\n\n  function injectHeaders(menu) {\n    if (!menu || menu.dataset.jtlHeadersInjected === \"true\") return;\n    let injected = false;\n    for (const { before, label } of SECTIONS) {\n      const target = menu.querySelector(\n        `[data-dropdown-item=\"${CSS.escape(before)}\"]`\n      );\n      if (!target) continue;\n      const header = document.createElement(\"div\");\n      header.className = \"jtl-nav-section-header\";\n      header.textContent = label;\n      target.parentNode.insertBefore(header, target);\n      injected = true;\n    }\n    if (injected) menu.dataset.jtlHeadersInjected = \"true\";\n  }\n\n  function scan(root) {\n    if (!(root instanceof HTMLElement)) return;\n    if (root.matches?.(\".nav-dropdown-content\")) {\n      injectHeaders(root);\n      return;\n    }\n    root.querySelectorAll?.(\".nav-dropdown-content\").forEach(injectHeaders);\n  }\n\n  const observer = new MutationObserver((mutations) =\u003e {\n    for (const m of mutations) {\n      m.addedNodes.forEach(scan);\n    }\n  });\n\n  function start() {\n    observer.observe(document.body, { childList: true, subtree: true });\n    document.querySelectorAll(\".nav-dropdown-content\").forEach(injectHeaders);\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", start);\n  } else {\n    start();\n  }\n})();\n"])</script><script>self.__next_f.push([1,"50:[\"$\",\"$L56\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6a2aa44415aa7c011cbd7de0\",\"filePath\":\"nav-headers.js\",\"subdomain\":\"jtlsoftwaregmbh\",\"__v\":0,\"content\":\"$57\"}]}]\n5a:Tc44,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];const Playground=({token,tenantId})=\u003e{const _components={iframe:`iframe`,..._provideComponents()};const iframeRef=React.useRef(null);const tokenRef=React.useRef(token);const tenantIdRef=React.useRef(tenantId);React.useEffect(()=\u003e{function onMessage(event){if(event.data?.type!==`graphql-playground-ready`)return;const iframe=iframeRef.current;if(!iframe?.contentWindow)return;const config={type:`graphql-config`,url:`https://api.jtl-cloud.com/erp/v2/graphql`};const authHeader=tokenRef.current;if(authHeader){config.token=authHeader.replace(/^Bearer\\s+/i,``);if(tenantIdRef.current){config.headers={\"x-tenant-id\":tenantIdRef.current}}}iframe.contentWindow.postMessage(config,`https://jtl-software.github.io`)}window.addEventListener(`message`,onMessage);r