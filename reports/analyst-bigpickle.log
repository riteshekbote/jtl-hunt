function getUrlParam(parameter, defaultvalue) {
    var params = this.window.location.search.replace('?', '').split('&');
    var param = params.find(function(param) {
        return param.split('=')[0] === parameter;
    });
    if (param === undefined || param === '') {
        return defaultvalue;
    }
    var value = param.split("=")[1];
    return value === undefined ? defaultvalue : decodeURIComponent(value);
}

function normalizeVersion(version) {
    if (!version) {
        return null;
    }
    var lowered = version.toLowerCase();
    if (lowered === "current") {
        return "current";
    }
    if (lowered.startsWith("v")) {
        return version;
    }
    return "v" + version;
}

function getAvailableVersions() {
    if (typeof apiVersions === "undefined" || !Array.isArray(apiVersions) || apiVersions.length === 0) {
        return ["v1"];
    }
    return apiVersions.map(normalizeVersion).filter(function(v) { return v; });
}

function getAvailableApis() {
    if (typeof apis !== "undefined" && Array.isArray(apis) && apis.length > 0) {
        return apis;
    }
    return [
        { id: "fulfiller", name: "Fulfiller API" },
        { id: "merchant", name: "Merchant API" },
        { id: "any", name: "Shared API" }
    ];
}

function getContextUrl(id, version) {
    return '/api-docs/' + id + '-' + version + '/swagger.json'
}
