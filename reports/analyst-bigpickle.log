import json, difflib

def load(p):
    return json.load(open(p))

for role in ["fulfiller","merchant","any"]:
    p = load(f"prod-{role}.json")
    s = load(f"sbx-{role}.json")
    print(f"=== {role} ===")
    print("  title prod:", p.get("info",{}).get("title"), "| sbx:", s.get("info",{}).get("title"))
    print("  version prod:", p.get("info",{}).get("version"), "| sbx:", s.get("info",{}).get("version"))
    pp = set(p.get("paths",{}).keys())
    sp = set(s.get("paths",{}).keys())
    print("  paths only-prod:", sorted(pp-sp))
    print("  paths only-sbx:", sorted(sp-pp))
    if pp==sp:
        for path in sorted(sp):
            pm = set(p["paths"][path].keys())
            sm = set(s["paths"][path].keys())
            if pm!=sm:
                print("  ", path, "methods prod:", sorted(pm), "sbx:", sorted(sm))
    # compare schemas sets
    ps = set(p.get("components",{}).get("schemas",{}).keys())
    ss = set(s.get("components",{}).get("schemas",{}).keys())
    print("  schemas only-prod:", sorted(ps-ss))
