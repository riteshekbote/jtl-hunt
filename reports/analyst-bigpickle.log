Merchant spec identical except base-URL string. Closing out the divergence check across the other spec groups (shared/fulfiller, current+v1), passive.
[0m$ [0mcd /tmp/opencode
for g in shared fulfiller; do
  for v in current v1; do
    curl -sS -o sbx-$g-$v.json -w "sbx $g/$v HTTP %{http_code} size=%{size_download}\n" --max-time 30 "https://ffn-sbx.api.jtl-software.com/api-docs/$g-$v/swagger.json"; sleep 1
    curl -sS -o prod-$g-$v.json -w "prod $g/$v HTTP %{http_code} size=%{size_download}\n" --max-time 30 "https://ffn.api.jtl-software.com/api-docs/$g-$v/swagger.json"; sleep 1
  done
done
echo "=== raw size DB ==="
for g in shared fulfiller merchant; do
  for v in current v1; do
    if [ -f sbx-$g-$v.json ] && [ -f prod-$g-$v.json ]; then
      s1=$(stat -c%s prod-$g-$v.json); s2=$(stat -c%s sbx-$g-$v.json)
      echo "$g/$v prod=$s1 sbx=$s2 delta=$((s2-s1))"
    fi
  done
done
