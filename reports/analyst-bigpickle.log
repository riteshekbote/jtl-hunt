function getUrlParam(parameter, defaultvalue) {
    var params = this.window.location.search.replace('?', '').split('&');
    var param = params.find(function(param) {
        return param.split('=')[0] === parameter;
    });
    if (param === undefined || param === '') {
        return defaultvalue;
    }
    var value = param.split("=")[1];
    return value === undefined ? defaultvalue : decodeURIComponent(value);
}

function normalizeVersion(version) {
    if (!version) {
        return null;
    }
    var lowered = version.toLowerCase();
    if (lowered === "current") {
        return "current";
    }
    if (lowered.startsWith("v")) {
        return version;
    }
    return "v" + version;
}

function getAvailableVersions() {
    if (typeof apiVersions === "undefined" || !Array.isArray(apiVersions) || apiVersions.length === 0) {
        return ["v1"];
    }
    return apiVersions.map(normalizeVersion).filter(function(v) { return v; });
}

function getAvailableApis() {
    if (typeof apis !== "undefined" && Array.isArray(apis) && apis.length > 0) {
        return apis;
    }
    return [
        { id: "fulfiller", name: "Fulfiller API" },
        { id: "merchant", name: "Merchant API" },
        { id: "any", name: "Shared API" }
    ];
}

function getContextUrl(id, version) {
    return '/api-docs/' + id + '-' + version + '/swagger.json'
}
function jump(h){
    var url = location.href;
    location.href = "#"+h;
    history.replaceState(null,null,url);
}

function afterInit(){
    if(document.location.hash !== undefined && document.location.hash !== null && document.location.hash !== ""){
        var anchor = Array.from(document.getElementsByTagName("li")).filter(function(l){return l.getAttribute("data-item-id") === document.location.hash.replace('#','')}).length;
        if(anchor === 0){
            location.href = "#section/Endpoints";
        }
    }
    
    function setBetaClass(element,index,array){
        let id = element.dataset.sectionId;
        let child = document.querySelectorAll('[data-item-id="' + id + '"]')[0].firstChild.firstChild;
        child.className += " beta_tag";
    }
    Array.from(document.getElementsByClassName("beta_summary")).forEach(setBetaClass)    
}
// initially render first API
var redocOptions = JSON.parse('{"untrustedSpec":false,"hideHostname":true,"hideDownloadButton":false,"expandResponses":"","requiredPropsFirst":true,"noAutoAuth":false,"pathInMiddlePanel":false,"nativeScrollbars":true,"disableSearch":false,"onlyRequiredInSamples":false,"sortPropsAlphabetically":false}');
var redocContainer = document.getElementById('redoc-container');



function buildUrl(role, version) {
    return window.location.origin
        + window.location.pathname
        + "?role=" + encodeURIComponent(role)
        + "&version=" + encodeURIComponent(version)
        + window.location.hash;
}

function onClick() {
    var contextId = this.getAttribute('role');
    window.location.href = buildUrl(contextId, selectedVersion);
}
var selectedRole = getUrlParam("role", "fulfiller");
var availableVersions = getAvailableVersions();
var availableApis = getAvailableApis();
var selectedVersion = normalizeVersion(getUrlParam("version", availableVersions[0]));
if (availableVersions.indexOf(selectedVersion) === -1) {
    selectedVersion = availableVersions[0];
}
// dynamically building navigation items
var $list = document.getElementById('links_container');
availableApis.forEach(function(api) {
    var $listitem = document.createElement('li');
    $listitem.setAttribute('role', api.id);

    $listitem.innerText = api.name;
    $listitem.addEventListener('click', onClick);
    if(api.id === selectedRole){
        $listitem.className = "selected";
    }
    $list.appendChild($listitem);
});

var $versionItem = document.createElement('li');
$versionItem.setAttribute('id', 'version_container');
var $versionLabel = document.createElement('span');
$versionLabel.setAttribute('id', 'version_label');
$versionLabel.innerText = "Version:";
var $versionSelect = document.createElement('select');
$versionSelect.setAttribute('id', 'version_selector');
availableVersions.forEach(function(version) {
    var $option = document.createElement('option');
    $option.value = version;
    $option.innerText = version;
    if (version === selectedVersion) {
        $option.selected = true;
    }
    $versionSelect.appendChild($option);
});
$versionSelect.addEventListener('change', function() {
    selectedVersion = this.value;
    window.location.href = buildUrl(selectedRole, selectedVersion);
});
$versionItem.appendChild($versionLabel);
$versionItem.appendChild($versionSelect);
$list.appendChild($versionItem);

Redoc.init(getContextUrl(selectedRole, selectedVersion), redocOptions, redocContainer, afterInit);
