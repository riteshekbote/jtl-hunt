import json
with open('erp_openapi.json') as f:
    spec = json.load(f)
paths = spec.get('paths', {})
print('Total paths:', len(paths))
# Find unauthenticated or interesting endpoints
for p, methods in paths.items():
    for m, info in methods.items():
        if m not in ('get','post','put','delete','patch'): continue
        sec = info.get('security', '')
        tags = info.get('tags', [])
        print(m.upper(), p, '| tags:', tags, '| sec:', sec)
